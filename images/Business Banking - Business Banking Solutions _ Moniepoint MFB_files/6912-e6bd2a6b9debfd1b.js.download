"use strict";(self.webpackChunk_N_E=self.webpackChunk_N_E||[]).push([[6912],{6912:function(e,t,n){n.d(t,{r:function(){return r},v:function(){return s}});var o=n(1527),a=n(8197),i=n.n(a);let s={moniepointMfb:{"@context":"https://schema.org","@type":"LocalBusiness",name:"Moniepoint Nigeria",description:"We are a financial services company based in Nigeria, offering a range of business banking services including business accounts, business loans, pos terminal machines, expense cards, and more.",image:"https://moniepoint.com/static/MFB-667f089014bfae5d706fc620b07be2e0.png",address:{"@type":"PostalAddress",streetAddress:"12, Wole Ariyo Street.",addressLocality:"Lekki Phase 1",addressRegion:"Lagos",postalCode:"106104",addressCountry:"NG"},geo:{"@type":"GeoCoordinates",latitude:6.443,longitude:3.45908},url:"https://moniepoint.com/ng/",telephone:"+01 888 9990",openingHoursSpecification:{"@type":"OpeningHoursSpecification",dayOfWeek:["Monday","Tuesday","Wednesday","Thursday","Friday"],opens:"08:00",closes:"17:00"},sameAs:["https://www.facebook.com/Moniepointng/","https://instagram.com/moniepointng","https://twitter.com/moniepointng","https://www.linkedin.com/showcase/moniepoint/"]},contact:{"@context":"https://schema.org","@type":"ContactPage",about:{"@type":"Organization",name:"Moniepoint Nigeria",url:"https://moniepoint.com/ng",logo:"https://moniepoint.com/static/MFB-667f089014bfae5d706fc620b07be2e0.png",contactPoint:{"@type":"ContactPoint",telephone:"+01 888 9990",contactType:"customer service",areaServed:"NG",availableLanguage:"English"}},breadcrumb:{"@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Home",item:"https://moniepoint.com/ng"},{"@type":"ListItem",position:2,name:"Contact",item:"https://moniepoint.com/ng/contact-us"}]}},businessAccount:{"@context":"https://schema.org","@type":"FAQPage",mainEntity:[{"@type":"Question",name:"Will I be affected as an existing customer?",acceptedAnswer:{"@type":"Answer",text:"As an existing customer, you can enable the USSD channel from your mobile or web applications via settings. You will need to authorise this action using your user PIN."}},{"@type":"Question",name:"How much would it cost to use USSD?",acceptedAnswer:{"@type":"Answer",text:"Dialing the Moniepoint USSD code *5573# doesn't cost anything."}},{"@type":"Question",name:"What are the short codes for all services on USSD?",acceptedAnswer:{"@type":"Answer",text:"You can either access the specific flow by dialing the main USSD code *5573# and selecting the relevant flow from the main menu or dial a slightly extended code that can directly lead you to the needed flow. "}},{"@type":"Question",name:"Can I accept transfers with my Moniepoint POS terminal?",acceptedAnswer:{"@type":"Answer",text:"The various USSD functions and their limits include; Transfer Single limit: 20,000, Transfer daily cumulative limit: 100,000, Airtime single and daily limit: 10,000, Data single and daily limit: 10,000"}},{"@type":"Question",name:"Will everyone with my phone have access to my private information?",acceptedAnswer:{"@type":"Answer",text:"No, any sensitive operation (seeing the balance, performing any kind of transaction, changing the user PIN, etc.) will need to be authorised through the user PIN."}},{"@type":"Question",name:"What if I see a message telling me that the channel is not enabled after trying to dial the USSD code?",acceptedAnswer:{"@type":"Answer",text:"The channel can be enabled from either the mobile application (business or personal) or the web app."}},{"@type":"Question",name:"Can I disable the USSD channel after enabling it?",acceptedAnswer:{"@type":"Answer",text:"Yes, you can always enable/disable the channel from the settings pages in the personal & business applications and on the web application."}},{"@type":"Question",name:"What if I see a message telling me that I don't have a moniepoint account even though I do?",acceptedAnswer:{"@type":"Answer",text:"Make sure you dial the USSD code from your registered mobile number with your account; this could happen when you dial the USSD code from an unregistered mobile number."}},{"@type":"Question",name:"What if I don't see all my moniepoint accounts in the list of accounts?",acceptedAnswer:{"@type":"Answer",text:"If you have chosen to use a different phone number during your onboarding process from business to personal or vice versa, that will affect the accounts you see when use the phone number to dial the USSD code."}},{"@type":"Question",name:"Can I block my own account(s)?",acceptedAnswer:{"@type":"Answer",text:'Yes, you can by dialing the USSD code *5573*911# from your phone number and choosing the "Stop Debit transactions" and then "for yourself" options, which will prompt you to enter your user PIN. If verified successfully, it will block all your moniepoint accounts (business, personal, and business owner accounts).'}},{"@type":"Question",name:"What if my phone was stolen, and I don't have access to the SIM?",acceptedAnswer:{"@type":"Answer",text:'You can still block your account(s) if you have a friend/family member with access to the Moniepoint USSD channel. All you/they have to do is dial the same USSD code *5573*911#, choosing the "Stop Debit transactions" and "for others" options, then provide the phone number or account number of the intended user whose accounts are to be blocked. You/they will be asked to provide the user PIN for the account(s) owner, not the owner of the channel(phone). If verified successfully, this will block all your Moniepoint accounts (business, personal, and business owner accounts).'}},{"@type":"Question",name:"Can I unblock my account(s)?",acceptedAnswer:{"@type":"Answer",text:"At any point the user who blocked the account(s) (whether they were their own accounts or others) is the only user who can unblock the accounts."}},{"@type":"Question",name:"Can I open a new Moniepoint account using USSD?",acceptedAnswer:{"@type":"Answer",text:"Not at the moment, but this feature will be available soon."}}]},pos:{"@context":"https://schema.org","@type":"FAQPage",mainEntity:[{"@type":"Question",name:"How much do I pay to get a Moniepoint POS Terminal?",acceptedAnswer:{"@type":"Answer",text:"To get the Moniepoint POS, you pay N21,500."}},{"@type":"Question",name:"How long does it take to get a Moniepoint POS terminal?",acceptedAnswer:{"@type":"Answer",text:"After you make a request, you can get the Moniepoint POS terminal within 48hrs."}},{"@type":"Question",name:"What cards can I accept on my Moniepoint POS terminal?",acceptedAnswer:{"@type":"Answer",text:"Your POS terminal is compatible with all cards."}},{"@type":"Question",name:"Can I accept transfers with my Moniepoint POS terminal?",acceptedAnswer:{"@type":"Answer",text:"Yes you can."}},{"@type":"Question",name:"Do I need special training to use the Moniepoint POS terminal?",acceptedAnswer:{"@type":"Answer",text:"No, but you can always contact our customer support if you have any questions."}}]},personalBanking:{"@context":"https://schema.org","@type":"FAQPage",mainEntity:[{"@type":"Question",name:"How can I open a savings account with your bank?",acceptedAnswer:{"@type":"Answer",text:"To open a savings account, simply download the Moniepoint Personal Banking app to get started and follow the prompt."}},{"@type":"Question",name:"What is the minimum initial deposit required to open a savings account?",acceptedAnswer:{"@type":"Answer",text:"Opening an account with Moniepoint is free. There is no initial deposit required."}},{"@type":"Question",name:"Does the Moniepoint Personal Bank Account have a minimum balance requirement?",acceptedAnswer:{"@type":"Answer",text:"No, there is no minimum balance required."}},{"@type":"Question",name:"Are there any monthly maintenance fees associated with the savings account?",acceptedAnswer:{"@type":"Answer",text:"No, there are no monthly maintenance fees or charges."}},{"@type":"Question",name:"Are there any restrictions or penalties for withdrawing money from my account?",acceptedAnswer:{"@type":"Answer",text:"No, you can withdraw your money as many times as you like."}},{"@type":"Question",name:"Can I set up automatic transfers or direct deposits into my savings account to help with saving?",acceptedAnswer:{"@type":"Answer",text:"Yes, you can typically set up automatic transfers or direct deposits into your Moniepoint savings account to help with your savings goals. This can be a convenient way to save regularly."}},{"@type":"Question",name:"What are the options for receiving statements and monitoring account activity?",acceptedAnswer:{"@type":"Answer",text:"Account statements and activity are available through our online banking, mobile apps, email statements, and SMS channels."}},{"@type":"Question",name:"Is my money safe with Moniepoint?",acceptedAnswer:{"@type":"Answer",text:"Moniepoint Microfinance Bank is authorized and regulated by the Central Bank of Nigeria to offer banking services. Deposits are insured by the Nigerian Deposit Insurance Corporation (NDIC)."}}]},personalCards:{"@context":"https://schema.org","@type":"FAQPage",mainEntity:[{"@type":"Question",name:"What is a debit card?",acceptedAnswer:{"@type":"Answer",text:"A debit card is a payment card that allows you to make purchases by deducting funds directly from your linked bank account, often with the option to withdraw cash from ATMs."}},{"@type":"Question",name:"How do I request a Moniepoint Debit Card?",acceptedAnswer:{"@type":"Answer",text:"Simply download the Moniepoint app to request your debit card. Cards are delivered within 48hrs to your doorstep."}},{"@type":"Question",name:"How long does it take to receive my debit card after applying for it?",acceptedAnswer:{"@type":"Answer",text:"Within 48hours."}},{"@type":"Question",name:"How do I activate my Debit card?",acceptedAnswer:{"@type":"Answer",text:"To activate your Moniepoint Debit Card,open the app and activate your card."}},{"@type":"Question",name:"Where can I use my Moniepoint Debit Card?",acceptedAnswer:{"@type":"Answer",text:"You can use your Moniepoint Debit Card at any merchant, POS or ATM that accepts debit card payments."}},{"@type":"Question",name:"How many ATMs accept the Moniepoint Debit Cards?",acceptedAnswer:{"@type":"Answer",text:"Moniepoint Debit Cards are accepted at all ATMS nationwide"}},{"@type":"Question",name:"What do I do if my Moniepoint Debit Card is lost, stolen or misplaced?",acceptedAnswer:{"@type":"Answer",text:"If your debit card is lost, stolen, or misplaced, you should immediately disable it through the mobile app and contact Moniepoint's customer service to report it."}},{"@type":"Question",name:"What do I do if I forget my pin?",acceptedAnswer:{"@type":"Answer",text:"If you forget your PIN for your Moniepoint Debit Card, you can reset it through the mobile app or online banking."}},{"@type":"Question",name:"What is the daily or monthly spending limit on my debit card?",acceptedAnswer:{"@type":"Answer",text:"There is no daily, weekly or monthly spending limit on your debit card."}},{"@type":"Question",name:"Can I use my debit card for online purchases, and is it secured for online transactions?",acceptedAnswer:{"@type":"Answer",text:"Yes, you can use your Moniepoint Debit Card for online purchases, and it is often secured for online transactions"}}]},personalPayment:{"@context":"https://schema.org","@type":"FAQPage",mainEntity:[{"@type":"Question",name:"What bills can I pay with the Moniepoint app?",acceptedAnswer:{"@type":"Answer",text:"With the Moniepoint app, you can pay your electricity bill , waste bill , internet bill, streaming service and more."}},{"@type":"Question",name:"Is it possible to set up automatic bill payments?",acceptedAnswer:{"@type":"Answer",text:"Yes, you can schedule automatic bill payments in advance through the Moniepoint app."}},{"@type":"Question",name:"Can I purchase data and airtime for my mobile phone?",acceptedAnswer:{"@type":"Answer",text:"Yes, you can buy data or airtime for yourself or any other person through the mobile app."}},{"@type":"Question",name:"Are there any transaction fees associated with paying bills on the Moniepoint app?",acceptedAnswer:{"@type":"Answer",text:"There is no extra transaction fee associated with paying your bills using the Moniepoint app."}},{"@type":"Question",name:"How quickly are payments processed?",acceptedAnswer:{"@type":"Answer",text:"Payments are processed immediately through the Moniepoint app."}},{"@type":"Question",name:"Can I view my payment history and transaction receipts through your platform for record-keeping purposes?",acceptedAnswer:{"@type":"Answer",text:"Yes, you can view your payment history and access transaction history through the Moniepoint app or your online account. This feature is useful for record-keeping and tracking your financial transactions."}}]},personal:{"@context":"https://schema.org","@type":"FAQPage",mainEntity:[{"@type":"Question",name:"What is personal banking?",acceptedAnswer:{"@type":"Answer",text:"Personal banking refers to financial services and products offered to individuals by a bank, including savings accounts, loans, and other services tailored for personal financial management."}},{"@type":"Question",name:"What documents do I need to open a Moniepoint Personal Bank account?",acceptedAnswer:{"@type":"Answer",text:"To open an account, you only need a valid Nigerian phone number, a functional email address and your BVN. These will give you access to a functional bank account on KYC Level 1. Click here to learn more about the KYC levels."}},{"@type":"Question",name:"Is there a fee for opening an account?",acceptedAnswer:{"@type":"Answer",text:"No, there is no fee for opening or maintaining an account with Moniepoint."}},{"@type":"Question",name:"Is Moniepoint safe?",acceptedAnswer:{"@type":"Answer",text:"Yes! At Moniepoint, we take security seriously by implementing robust security measures to protect your financial information and transactions. We are also regulated by CBN and insured by NDIC."}},{"@type":"Question",name:"Can a personal bank account be used for business?",acceptedAnswer:{"@type":"Answer",text:"We recommend that you have a separate personal bank account and business account to keep track of your finances properly."}},{"@type":"Question",name:"How many personal bank accounts can I have?",acceptedAnswer:{"@type":"Answer",text:"You can have more than one personal bank account depending on your financial goal."}}]},workingCapital:{"@context":"https://schema.org","@type":"FAQPage",mainEntity:[{"@type":"Question",name:"How can I get a loan?",acceptedAnswer:{"@type":"Answer",text:"You can apply for a loan within the Moniepoint app."}},{"@type":"Question",name:"Do I need to be using Moniepoint to get a loan?",acceptedAnswer:{"@type":"Answer",text:"Yes, you need a Moniepoint account to apply for a loan."}},{"@type":"Question",name:"Can I pay in installments?",acceptedAnswer:{"@type":"Answer",text:"Yes. Your loan repayments are automatically deducted from your account based on your payment plan."}},{"@type":"Question",name:"How much can I get as a loan?",acceptedAnswer:{"@type":"Answer",text:"The amount depends on your business, and is determined during the application process."}},{"@type":"Question",name:"Who can I ask questions about getting a loan?",acceptedAnswer:{"@type":"Answer",text:"Our support team is always ready to answer your questions."}}]},expenseCards:{"@context":"https://schema.org","@type":"FAQPage",mainEntity:[{"@type":"Question",name:"How can I get an expense card?",acceptedAnswer:{"@type":"Answer",text:"Download the Moniepoint app, request for a card within the app and it'll be delivered to you."}},{"@type":"Question",name:"How long does it take to get an expense card?",acceptedAnswer:{"@type":"Answer",text:"Your expense card will be delivered to you within 48 hours."}},{"@type":"Question",name:"Can I get multiple expense cards?",acceptedAnswer:{"@type":"Answer",text:"Yes. You can get multiple expense cards linked to the same business account."}},{"@type":"Question",name:"How can I activate my card?",acceptedAnswer:{"@type":"Answer",text:"You card can be activated from within the Moniepoint app."}},{"@type":"Question",name:"I misplaced my card. What can I do?",acceptedAnswer:{"@type":"Answer",text:"You can deactivate the card within the app to prevent fraudulent use."}}]},moniebook:{"@context":"https://schema.org","@type":"FAQPage",mainEntity:[{"@type":"Question",name:"Why use Moniebook?",acceptedAnswer:{"@type":"Answer",text:"Moniebook simplifies your business operations by providing a centralized platform for managing sales, inventory, payments, and customers. It helps improve efficiency, provides real-time insights, and supports data-driven decision-making to grow your business."}},{"@type":"Question",name:"Who is Moniebook for?",acceptedAnswer:{"@type":"Answer",text:"Moniebook is designed for small, medium and large retail & hospitality businesses."}},{"@type":"Question",name:"Is there a free trial?",acceptedAnswer:{"@type":"Answer",text:"Every registered business enjoys a 30-day free trial with complete access to all Moniebook features."}},{"@type":"Question",name:"Can I use Moniebook with my existing Moniepoint terminal?",acceptedAnswer:{"@type":"Answer",text:"This is dependent on your type of terminal. Moniebook works only on the following devices: Moniepoint P8 terminal, Android, iOS, PC and mobile web."}},{"@type":"Question",name:"What kind of businesses use Moniebook?",acceptedAnswer:{"@type":"Answer",text:"Moniebook was built for supermarkets, pharmacies, restaurants, boutiques, salons, etc."}}]}},r=e=>{let{data:t}=e;return(0,o.jsx)(i(),{children:(0,o.jsx)("script",{type:"application/ld+json",dangerouslySetInnerHTML:{__html:JSON.stringify(t)}})})}}}]);