(self.webpackChunk_N_E=self.webpackChunk_N_E||[]).push([[199],{3507:function(e,n,t){(window.__NEXT_P=window.__NEXT_P||[]).push(["/ng/moniepoint-ussd",function(){return t(2627)}])},2627:function(e,n,t){"use strict";t.r(n),t.d(n,{__N_SSG:function(){return m},default:function(){return g}});var s=t(1527),o=t(6146),i=t(4067),a=t(6111),r=t(6912),d=t(3273);let l={meta:t(1164).s.ussd,pos:!0,hero:{tag:"USSD",title:"The Moniepoint USSD code for easy offline banking.",desc:(0,s.jsxs)(s.Fragment,{children:["Activate the USSD feature to easily transfer funds, top-up airtime and data, check your balance, reset your PIN, block and unblock your account without internet connection.",(0,s.jsx)("br",{}),(0,s.jsx)("em",{children:"Dial *5573# today."})]}),cta:"Activate USSD Now",link:d.KW,img:"/business/hero-u.png"},benefitsSub:{className:"benefits-ussd",title:"No Internet? <br><em>No Worries</em>",desc:"Bank with *5573#",ctaLink:d.KW,ctatext:"Enable USSD Now",benefits:[{title:"Enjoy Instant and Smooth Transfers",desc:"Easily transfer funds to your friends, family, and vendors without the challenge of a hanging network connection.",img:"/pos/pos-5.png"},{title:"Buy Airtime and Data",desc:"No data to buy data? Keep the conversation going. Dial *5573# to buy airtime and data for yourself and your friends speedily.",img:"/pos/pos-6.png"},{title:"Secure your Account",desc:"Not sure if your account is compromised? Your peace of mind is guaranteed! Block and unblock your account with or without your phone by dialing *5573*911#.",img:"/pos/pos-7.png"},{title:"Check Balance, Reset PIN, & Retrieve OTP",desc:"Dial *5573# to stay informed of your financial details, retrieve your OTP, and reset your PIN securely anytime, anywhere.",img:"/pos/pos-8.png"}]},getStarted:{title:"Here's how to activate your USSD code",steps:[{title:"Log in to your account",desc:"Open the Moniepoint Personal or Business banking app and log in to your dashboard.\xa0",img:"/start/pos-5.png"},{title:"Go to the Settings menu",desc:"Click on your profile picture at the top left corner of your dashboard and then click on the Settings menu",img:"/start/pos-6.png"},{title:"Turn on the USSD feature",desc:"Locate the USSD Feature option and switch it on to activate it.",img:"/start/pos-7.png"},{title:"You're done!",desc:"Enjoy easy offline banking. Transfer funds, top-up airtime and data, check your balance, reset your PIN, and block and unblock your account without an internet connection.",img:"/start/pos-8.png"}]},faqs:[{question:"Will I be affected as an existing customer?",answer:"<p>As an existing customer, you can enable the USSD channel from your mobile or web applications via settings. You will need to authorise this action using your user PIN.</p>"},{question:"How much would it cost to use USSD?",answer:"<p>Dialing the Moniepoint USSD code *5573# doesn't cost anything.</p>"},{question:"What are the short codes for all services on USSD?",answer:"<div>\n      <p>You can either access the specific flow by dialing the main USSD code *5573# and selecting the relevant flow from the main menu or dial a slightly extended code that can directly lead you to the needed flow. The available direct codes include:</p>\n      <table>\n        <tbody>\n          <tr>\n                <td class='grey'>Check balance and account details</td>\n                <td><b>*5573*5#</b></td>\n          </tr>\n          <tr>\n            <td class='grey'>Transfer to moniepoint account</td>\n            <td><b>*5573*1*Amount*Account Number#</b></td>\n          </tr>\n          <tr>\n            <td>Transfer to other banks</td>\n            <td><b>*5573*2*Amount*Account Number#</b></td>\n          </tr>\n\n          <tr>\n            <td>Buy Airtime (SELF)</td>\n            <td><b>*5573*Amount#</b></td>\n          </tr>\n          <tr>\n          <td>Buy Airtime (OTHERS)</td>\n          <td><b>*5573*Amount*Phone Number#</b></td>\n        </tr>\n        <tr>\n          <td>Buy Data</td>\n          <td><b>*5573*4#</b></td>\n        </tr>\n        <tr>\n          <td>Reset user PIN</td>\n          <td><b>**5573*6#</b></td>\n        </tr>\n        <tr>\n          <td>Get OTP</td>\n          <td><b>*5573*73Code#</b></td>\n        </tr>\n        <tr>\n          <td>Block account</td>\n          <td><b>*5573*911#</b></td>\n        </tr>\n        <tr>\n        <td>Forgot username</td>\n        <td><b>*5573*73*1#</b></td>\n      </tr>\n      <tr>\n        <td>Get OTP (signup)</td>\n        <td><b>*5573*74Code#</b></td>\n      </tr>\n\n        </tbody>\n      </table>\n      </div>"},{question:"Can I accept transfers with my Moniepoint POS terminal?",answer:"<div>\n      <p>The various USSD functions and their limits include;</p>\n        <ul>\n          <li>Transfer Single limit: 20,000 </li>\n          <li> Transfer daily cumulative limit: 100,000</li>\n          <li> Airtime single and daily limit: 10,000</li>\n          <li> Data single and daily limit: 10,000</li>\n        </ul>\n      </div>"},{question:"Will everyone with my phone have access to my private information?",answer:"<p>No, any sensitive operation (seeing the balance, performing any kind of transaction, changing the user PIN, etc.) will need to be authorised through the user PIN.</p>"},{question:"What if I see a message telling me that the channel is not enabled after trying to dial the USSD code?",answer:"<div>\n      <p>The channel can be enabled from either the mobile application (business or personal) or the web app.</p>\n        <ul>\n          <li>On the mobile apps, click on your profile picture -> Click on settings -> Turn on the USSD Banking feature.</li>\n          <li> On the web app, click the settings icon -> security tab -> USSD banking toggle.</li>\n          <li> Note that enabling/disabling the channel requires PIN authorisation.</li>\n        </ul>\n      </div>"},{question:"Can I disable the USSD channel after enabling it?",answer:"<p>\n      Yes, you can always enable/disable the channel from the settings pages in the personal & business applications and on the web application.\n      </p>"},{question:"What if I see a message telling me that I don't have a moniepoint account even though I do?",answer:"<p>\n      Make sure you dial the USSD code from your registered mobile number with your account; this could happen when you dial the USSD code from an unregistered mobile number.\n      </p>"},{question:"What if I don't see all my moniepoint accounts in the list of accounts?",answer:"<p>\n      If you have chosen to use a different phone number during your onboarding process from business to personal or vice versa, that will affect the accounts you see when use the phone number to dial the USSD code.\n      </p>\n      \n      <p>E.g., if a user already has a Moinepoint business profile and account using phone number A, logs it into the personal app, and opts to choose a different phone number B for their personal use, dialing the USSD code with phone number A will only allow them to see their business account(s), while dialing the USSD code with phone number B will allow them to see only their personal account.</p>"},{question:"Can I block my own account(s)?",answer:'<p>\n      Yes, you can by dialing the USSD code <b>*5573*911#</b> from your phone number and choosing the <b>"Stop Debit transactions"</b> and then <b>"for yourself"</b> options, which will prompt you to enter your user PIN. If verified successfully, it will block all your moniepoint accounts (business, personal, and business owner accounts).\n      </p>'},{question:"What if my phone was stolen, and I don't have access to the SIM?",answer:'<p>\n      You can still block your account(s) if you have a friend/family member with access to the Moniepoint USSD channel. All you/they have to do is dial the same USSD code <b>*5573*911#</b>, choosing the <b>"Stop Debit transactions"</b> and <b>"for others"</b> options, then provide the phone number or account number of the intended user whose accounts are to be blocked. \n      You/they will be asked to provide the user PIN for the account(s) owner, not the owner of the channel(phone). If verified successfully, this will block all your Moniepoint accounts (business, personal, and business owner accounts).\n      </p>'},{question:"Can I unblock my account(s)?",answer:"<p>\n      At any point the user who blocked the account(s) (whether they were their own accounts or others) is the only user who can unblock the accounts.\n      </p>"},{question:"Can I open a new Moniepoint account using USSD?",answer:"<p>\n      Not at the moment, but this feature will be available soon.\n      </p>"}],cta:{ctaTitle:"Join over 2 million businesses that trust Moniepoint.",ctaLink:d.mb,ctaText:"Open an Account"},script:r.v.pos};var c=t(315),u=t.n(c);let p=e=>{let{data:n}=e;return(0,s.jsxs)("div",{className:u()["hero-parent"],children:[(0,s.jsxs)("div",{className:u().hero,children:[(0,s.jsx)("svg",{className:u()["hero-svg"],width:"1411",height:"729",viewBox:"0 0 1411 729",fill:"none",xmlns:"http://www.w3.org/2000/svg",children:(0,s.jsxs)("g",{opacity:"0.03",clipPath:"url(#clip0_1781_11349)",children:[(0,s.jsx)("path",{opacity:"0.2",d:"M904.124 771.049L903.618 771.341C871.174 789.946 845.612 795.755 838.69 794.221C831.492 792.721 812.592 774.463 793.911 742.106C775.23 709.748 768.85 684.22 771.168 677.267C773.269 670.524 791.176 651.236 823.446 632.478L823.953 632.185C856.396 613.581 881.958 607.771 888.88 609.305C896.078 610.806 915.033 629.159 933.659 661.421C952.285 693.683 958.72 719.306 956.403 726.259C954.356 733.097 936.512 752.349 904.124 771.049Z",stroke:"#0357EE",strokeWidth:"4"}),(0,s.jsx)("path",{opacity:"0.3",d:"M951.919 826.638L951.003 827.28C892.308 868.123 844.605 883.473 831.175 881.72C817.225 880.077 778.241 848.531 737.35 790.132C696.459 731.733 680.109 684.252 683.376 670.638C686.265 657.459 717.176 617.761 775.516 576.655L776.433 576.014C835.127 535.17 882.831 519.82 896.26 521.573C910.211 523.216 949.315 554.934 990.