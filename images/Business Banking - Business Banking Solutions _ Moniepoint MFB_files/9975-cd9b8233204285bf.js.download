(self.webpackChunk_N_E=self.webpackChunk_N_E||[]).push([[9975],{6578:function(e,t,s){"use strict";s.d(t,{a:function(){return r}});var n=s(6912),a=s(5545),o=s(3273),i=s(1164);let r={"business-account":{meta:i.s.business["business-account"],faqs:[{question:"What do I need to open a Moniepoint business bank account?",answer:"All you need are;\n			<ul>\n			<li>A functional mobile phone number linked to your BVN and your email address</li>\n			<li>Your Bank Verification Number (BVN)</li>\n			<li>A smart device that can connect to the internet (either a smartphone or a computer)</li>\n			<li>A valid form of identification (NIN slip, PVC, international passport or driver's license)</li>\n			<li>Proof of address (Bank statement showing your address, PVC, driver's license, utility bill or tenancy agreement)</li>\n			</ul>"},{question:"How long would it take to get an account number?",answer:"Your business account number is created instantly. All you need to do is complete the signup process which takes less than 10 minutes."},{question:"Why should I open a Moniepoint account for my business?",answer:"A Moniepoint Business Account provides you with a bank account in your business name from the comfort of your home with no bank queues, paperwork, or opening balance. A Moniepoint business account also makes it easy for you to access business loans, a POS terminal for your business in less than 48 hours, a USSD code for offline banking, an expense card to keep track of your day-to-day business operational costs, and so much more."},{question:"My ID verification failed, what should I do?",answer:"Here are some tips to ensure your ID verification is successful: Take a picture of your face using our face-capturing tool in a well-lit room. Use only government-issued IDs such as a National Identification Number (NIN) slip, Permanent Voters’ Card (PVC), driver's license or international passport). Do not use expired documents; use clear images of the original documents, not photocopies. Details on the image need to be clear. If using the live capture document verification feature, ensure all edges of the documents are captured within the frame."},{question:"How can I retrieve my BVN if I forget it?",answer:"You can easily retrieve your BVN number by dialing the code *565*0# using the phone number you used to register your BVN. By following the prompts displayed after you dial the code, your BVN will be displayed on your mobile device for a service fee of N20. The method is fast and doesn't require any internet connection."},{question:"I started the signup process but didn't finish. What should I do?",answer:"If you got to the point of creating a username and password. All you need to do is login to your dashboard and you can continue from where you left off."}],cta:{ctaTitle:"Join over 2 million businesses that trust Moniepoint.",ctaLink:o.mb,ctaText:"Open an account"},hero:{tag:"Business Account",useH1TagForHeroTag:!0,title:"A <em>free bank account</em> to power your business",useH2TagForHeroTitle:!0,desc:"Ready to power your business? Choose Moniepoint - the banking solution that caters to all your needs, from collecting payments to accessing loans!",cta:"Open a Free Account",link:o.mb,img:"/business/hero-b.png",cards:[{value:"1M+",subtext:"Active terminals",icon:"/stats/ter.svg"},{value:"₦10 Trillion",subtext:"Processed monthly",icon:"/stats/pmt.svg"},{value:"99.9%",subtext:"Success rate",icon:"/stats/suc.svg"}]},benefitsSub:{title:"A business bank that <em>works</em> for you",ctaLink:o.mb,benefits:[{title:"Free business account",desc:"Get a Business account in your business name for free. No hidden charges.",img:"/business/business-1.png"},{title:"Easy account verification.",desc:"Enter your business details and get your details verified in minutes without visiting a physical location.",img:"/business/business-2.png"},{title:"Seamless banking experience",desc:"Send funds, pay bills and manage your business banking operations with a reliable banking solution.",img:"/business/business-3.png"},{title:"Round-the-clock support.",desc:"Whatever your concerns, our customer service team is here to support you.",img:"/business/business-4.png"}]},getStarted:{title:"Open an account in 5 minutes",steps:[{title:"Fill in your personal information",desc:"Provide your email and phone number and verify your phone number with an OTP.",img:"/start/bus-1.png"},{title:"Get verified",desc:"Select username & password. Provide your Bank Verification Number (BVN) and KYC details, and start face & ID verification. You can then provide your business name and set up a PIN for managing your account.",img:"/start/bus-2.png"},{title:"Fund your accounts",desc:"Top up your bank account to make smooth banking transactions.",img:"/start/bus-3.png"},{title:"You're done!",desc:"Login to your business dashboard and click on the Card menu to get an expense card.",img:"/start/bus-4.png"}]},script:n.v.businessAccount,disabled:!1},"working-capital-loans":{meta:i.s.business["working-capital-loans"],hero:{tag:"Working Capital Loans",title:"<em>Flexible loans</em> that help your business grow.",desc:"Get collateral-free loans to help your business grow.",cta:"Apply for a loan",link:o.mb,img:"/business/hero-w.png"},benefitsSub:{title:"Reason to get a <em>Working Capital Loan</em>",ctaLink:o.mb,benefits:[{title:"Low Collateral",desc:"Get a minimum of N1,000,000 and more without collateral",img:"/business/loans-1.png"},{title:"Low interest rates",desc:"Enjoy effective interest rates of 24-40% per annum",img:"/business/loans-2.png"},{title:"Quick Approvals",desc:"Approval in 24-72 hours",img:"/business/loans-3.png"},{title:"Long tenures",desc:"Repayment tenures that match your pace",img:"/business/loans-4.png"}]},getStarted:{title:"How to get access to our loan",steps:[{title:"Confirm your eligibility",desc:"Confirm your eligibility for a loan by logging into your dashboard to see available offers",img:"/start/wor-1.png"},{title:"Choose an offer",desc:"Choose an offer that best matches your business needs.",img:"/start/wor-2.png"},{title:"Receive the money",desc:"We review your choice and pay the money to your account in 1-2 business days.",img:"/start/wor-3.png"},{title:"You're done!",desc:"Login to your business dashboard and click on the Card menu to get an expense card.",img:"/start/wor-4.png"}]},faqs:[{question:"How can I get a loan?",answer:"You can apply for a loan within the Moniepoint app."},{question:"Do I need to be using Moniepoint to get a loan?",answer:"Yes, you need a Moniepoint account to apply for a loan."},{question:"Can I pay in installments?",answer:"Yes. Your loan repayments are automatically deducted from your account based on your payment plan."},{question:"How much can I get as a loan?",answer:"The amount depends on your business, and is determined during the application process."},{question:"Who can I ask questions about getting a loan?",answer:"Our support team is always ready to answer your questions."}],cta:{ctaTitle:"Your business is ready for the next level.",ctaDesc:"We give you the money you need to grow your business and pay back quickly so you can reinvest in what matters most.",ctaLink:o.mb,ctaText:"Apply for a loan"},script:n.v.workingCapital,disabled:!1},"expense-card":{meta:i.s.business["expense-card"],hero:{tag:"Expense Card",title:"A <em>secure card</em> for your business expenses",desc:"Track, reconcile and set limits on business spending with ease with Moniepoint business expense cards.",cta:"Open a Free Account",link:o.mb,img:"/business/hero-c.png"},benefitsSub:{title:"Why you should get a <em>Moniepoint Expense Card</em>",ctaLink:o.mb,ctatext:"Get an expense card",benefits:[{title:"Reliable payments every time.",desc:"Make reliable payments on ATMs, POS terminals and more.",img:"/business/expense-card-1.png"},{title:"Track card transaction",desc:"Get insights on your business expenditure, and monitor your card payments.",img:"/business/expense-card-2.png"},{title:"Set card limits",desc:"Set limits for cards, and assign them for effective expenditure management.",img:"/business/expense-card-3.png"},{title:"Quick delivery (wherever you are)",desc:"Order a card and get it delivered to your location in 48hrs.",img:"/business/expense-card-4.png"}]},getStarted:{title:"How to get your Expense card",steps:[{title:"Create a business account and log in",desc:"Provide the required information and a business account will be created for you instantly. Once done, login to your business dashboard and click on the POS menu.",img:"/start/exp-1.png"},{title:"Request a new card",desc:"Click on the Add a new Card button and follow the instructions.",img:"/start/exp-2.png"},{title:"Make payment and wait for delivery",desc:"Fund your Business Account with a minimum of N1,500 for the Expense Card. The N1,500 covers N1,000 for the card issuance fee, and N500 for the logistics fee. Your expense card will be delivered to your doorstep within 48 hours.",img:"/start/exp-3.png"},{title:"Get your card from the delivery agent",desc:"To collect your card from the delivery agent, you will need to provide the delivery code for the card. Login to your business account and click on the Card menu to access your delivery code.",img:"/start/exp-4.png"},{title:"Activate the Card",desc:"On your dashboard, click on the Card menu and then click on the delivered card under the “Cards Awaiting Delivery'' section. Click on the “Activate Now” button on the delivered card, set the PIN and card limits and you’re good to go.",img:"/start/exp-5.png"}]},benefits:{subtext:"A whole new business spending experience",list:[{title:"Request multiple expense cards",desc:"Need different cards for different needs? No worries. Request as many cards as you need.",img:"/stats/card.svg"},{title:"Set spending limits per expense card",desc:"Set limits for each card to stay in control of just how much you spend.",img:"/stats/lim.svg"},{title:"Assign cards based on business functions",desc:"Give your staff the power to make necessary purchases with assigned expense cards.",img:"/stats/ass.svg"}]},faqs:[{question:"How can I get an expense card?",answer:"Download the Moniepoint app, request for a card within the app and it'll be delivered to you."},{question:"How long does it take to get an expense card?",answer:"Your expense card will be delivered to you within 48 hours."},{question:"Can I get multiple expense cards?",answer:"Yes. You can get multiple expense cards linked to the same business account."},{question:"How can I activate my card?",answer:"You card can be activated from within the Moniepoint app."},{question:"I misplaced my card. What can I do?",answer:"You can deactivate the card within the app to prevent fraudulent use."}],cta:{ctaTitle:"Get a secure card for all your business expenses",ctaLink:o.mb,ctaText:"Get started"},script:n.v.expenseCards,disabled:!1},"point-of-sale-terminal":{meta:i.s.business["point-of-sale-terminal"],pos:!0,hero:{tag:"Point of Sale Terminal",title:"POS machine wey no get wahala.",desc:"Register today and begin accepting card and transfer payments with the Moniepoint POS terminal.",cta:"Get Started",link:o.LE,img:"/business/hero-p.png",cards:[{value:"1M+",subtext:"Active terminals",icon:"/stats/ter.svg"},{value:"₦10 Trillion",subtext:"Processed monthly",icon:"/stats/pmt.svg"},{value:"99.9%",subtext:"Success rate",icon:"/stats/suc.svg"}]},benefitsSub:{title:"Why <em>9 out of 10 businesses</em> in Nigeria choose Moniepoint",ctaLink:o.LE,ctatext:"Join the waitlist ",benefits:[{title:"POS Transfers",desc:"Accept transfers directly on your POS terminal, and print out customer receipts.",img:"/pos/pos-1.png"},{title:"Card Payments",desc:"Accept reliable payments that go through every time, from all cards.",img:"/pos/pos-2.png"},{title:"Instant settlement",desc:"Instantly receive payments in your account with no delay.",img:"/pos/pos-3.png"},{title:"99.9% reliability",desc:"Enjoy close to 100% success rate on all transactions with your terminal.",img:"/pos/pos-4.png"}]},getStarted:{title:"How to get your POS",steps:[{title:"Create a business account and log in",desc:"Provide the required information and a business account will be created for you instantly. Once done, login to your business dashboard and click on the POS menu.",img:"/start/pos-1.png"},{title:"Request a new POS",desc:"Click on the Add a new POS button and follow the instructions",img:"/start/pos-2.png"},{title:"Fund your account and pay for the terminal",desc:"Fund your newly created Business Account with a minimum of ₦21,500 for the POS Terminal and complete the request. The ₦21,500 covers a ₦10,000 caution fee, ₦10,000 logistics fee, and ₦1,500 insurance fee for 1 year.",img:"/start/pos-3.png"},{title:"Get your POS delivered within 48 hours",desc:"You will be instantly assigned a dedicated Relationship Manager from Moniepoint. The Relationship Manager will deliver the POS terminal to you within 48 hours, train you on how to use the terminal and answer any questions you may have.",img:"/start/pos-4.png"}]},benefits:{subtext:"Enjoy secure Banking, with roundthe clock support",list:[{title:"As secure as you expect.",desc:"Moniepoint uses up-to-date cybersecurity technology to protect your information and prevent unauthorised use",img:"/benefits/secure.svg"},{title:"Protection and peace of mind",desc:"Your funds are insured for up to N250,000 by the Nigerian Deposit Insurance Corporation.",img:"/benefits/protection.svg"},{title:"Anytime, anywhere, support",desc:"We’re always here to talk. Reach our support team however you need to - by phone, email, in the app, or check out the Help Center.",img:"/benefits/anytime.svg"}]},posPayment:{title:"<em>Up to 15% back</em> for every withdrawal, purchase, or POS transfer",desc:"Valid only for POS owners, from 16 July to 16 September 2025.",link:"/ng/business/point-of-sale-terminal/promotions",cta:"See payment rewards",disabled:!a.v.showPosPromotions},faqs:[{question:"How much do I pay to get a Moniepoint POS Terminal?",answer:"To get the Moniepoint POS, you pay N21,500."},{question:"How long does it take to get a Moniepoint POS terminal?",answer:"After you make a request, you can get the Moniepoint POS terminal within 48hrs."},{question:"What cards can I accept on my Moniepoint POS terminal?",answer:"Your POS terminal is compatible with all cards."},{question:"Can I accept transfers with my Moniepoint POS terminal?",answer:"Yes you can."},{question:"Do I need special training to use the Moniepoint POS terminal?",answer:"No, but you can always contact our customer support if you have any questions."}],cta:{ctaTitle:"Choose a POS terminal that makes business easy for you.",ctaLink:o.LE,ctaText:"Join the waitlist"},script:n.v.pos,disabled:!1},savings:{meta:i.s.business.savings,hero:{tag:"Savings",title:"<em>Achieve your business dreams </em> with a savings plan",desc:"Sign up for a savings plan, save for your business, and get up to 18% interest annually when you save. Start a savings plan with a minimum deposit of ₦1,000 today.",cta:"Start Saving Now",link:o.rr,img:"/business/hero-s.png"},benefitsSub:{title:"The smart way to <em>save for your business</em>",desc:"Choose how, when and what to save with a plan designed to achieve your business goals.",ctatext:"Save your business",ctaLink:o.rr,benefits:[{title:"Flexible saving and withdrawal options",desc:"Choose when and what to save, and enjoy the flexibility of how and where to withdraw.",img:"/personal/savings-d-1.png"},{title:"Competitive interest rates",desc:"Accrue up to 16% interest annually on your savings.",img:"/personal/savings-d-2.png"},{title:"NDIC secured",desc:"All savings are fully protected. Save with peace of mind.",img:"/personal/savings-d-3.png"},{title:"Halal Compliant",desc:"Choose to receive or not receive interest.",img:"/personal/savings-d-4.png"}]},subProduct:{title:"Plans designed for your dreams",desc:"With just ₦1,000 as your starting balance, you can begin saving for your dreams.",subs:[{title:"Save As U Transact",desc:"With a SAYT plan, you can save on every spend and watch your savings grow. Choose when and how much to save, and leave the rest to us.\xa0",img:"/business/savings-1.png"},{title:"Flexible Savings",desc:"Your personal emergency go-to wallet for rainy days. Start with a minimum balance of ₦1,000 and enjoy a flat rate interest of 9% annually.",img:"/business/savings-2.png"},{title:"Locked Savings",desc:"It is a smart and safe way to lock away funds for a fixed amount of time and accrue up to 9% - 16% interest annually.",img:"/business/savings-3.png"},{title:"Fixed Savings",desc:"A disciplined way to set aside huge sums for those big-budget, long-term and future projects. You can enjoy up to 10% - 18% interest annually.",img:"/business/savings-4.png"}]},faqs:[{question:"What is the minimum amount required to start a savings plan?",answer:"₦1,000"},{question:"Can I change the duration or tenure of my savings plan?",answer:"Yes, you can change the duration of your savings plan after creating it by going through the Manage plan flow to make any necessary changes."},{question:"Is there a penalty for withdrawing before the maturity date?",answer:"Penalties depend on your savings plan of choice. <br/><strong>Flexible Savings</strong> - No penalties <br/> <strong>Locked Savings & Fixed Savings</strong> - You lose all accrued interest.\xa0"},{question:"Is the interest rate fixed or variable for the savings plans?",answer:"<strong>Flexible Savings</strong> - Interest is fixed at a flat rate of 9% p.a. <br/>  <strong>Locked Savings & Fixed Savings</strong> - Interest varies based on tenure but can go as high as 16% p.a."},{question:"How frequently is the interest credited to my savings account?",answer:"Flexible Savings - Interest is accrued daily and paid at the end of every month.\xa0<br/>  Locked Savings - You can access interest at the end of your savings cycle<br/>  Fixed Savings - Interest is paid upfront.\xa0"},{question:"Can I have multiple savings plans simultaneously?",answer:"Yes, you can have as many savings plans as you desire"},{question:"What are the benefits of opting for a rollover at maturity?",answer:"Rollover at maturity allows you to maintain the same savings plan at any tenure you choose, making it easier to reconcile your savings instead of creating a new one."},{question:"Is there a limit on the number of rollovers I can perform?",answer:"No, there is not."}],cta:{ctaTitle:"Join over 2 million businesses that trust Moniepoint.",ctaLink:o.mb,ctaText:"Open an account"},disabled:!a.v.showSavingsPages},moniebook:{meta:i.s.business.moniebook,hero:{tag:"Moniebook",title:"<em>Smart POS software</em> that sorts it all, from sales to stock.",desc:"Automate how you sell, track, report, and manage your operations; no matter the size or location of your business.",cta:"Start Free Trial",secondaryCta:{cta:"Sign in",link:o.lk},ctatext:"Get started",link:o.lk,img:"/business/hero-m.png"},benefitsSub:{title:"One powerful tool to <em>simplify your operations</em>",ctaLink:o.lk,benefits:[{title:"Work smarter, save more time.",desc:"Get more done in less time in the all-in-one software for smart stock and sales management.",img:"/business/moniebook-card-1.png"},{title:"One system for all your branches",desc:"Control sales, pricing, and inventory across all branches anytime, anywhere from one dashboard.",img:"/business/moniebook-card-2.png"},{title:"Make smarter business decisions",desc:"Run operations with data insights. Manage sales, staff, stock, and customers using real-time reports.",img:"/business/moniebook-card-3.png"},{title:"Keep your business data safe",desc:"Stay secure with Moniebook's cloud backup. Your data is safe and updated in real-time.",img:"/business/moniebook-card-4.png"}]},features:{title:"Our Features",desc:"More Reasons to Grow with Moniebook.",features:[{title:"Inventory Management",desc:"Monitor your stock to avoid over or understocking. Automate reordering in real-time to keep your shelves stocked and your cash flowing.",img:"/business/feature-card-1.svg"},{title:"Sales Recording & Tracking",desc:"Gain full visibility into your daily sales, from customer purchases to payment methods and top-performing staff.",img:"/business/feature-card-2.svg"},{title:"Payment Processing",desc:"Integrate Moniepoint's existing payment terminals to allow seamless, secure transactions.",img:"/business/feature-card-3.svg"},{title:"Reporting & Analytics",desc:"Generate comprehensive financial reports that provide insights into top-selling items, peak sales hours and top performing categories.",img:"/business/feature-card-4.svg"},{title:"Staff Management",desc:"Manage team permissions and access with precision. Assign roles like cashier, branch manager, or inventory manager to control system access and streamline operations.",img:"/business/feature-card-5.svg"},{title:"Multi-Branch Management",desc:"Manage and monitor multiple store locations from a single platform, enabling centralized control of inventory, sales and employees.",img:"/business/feature-card-6.svg"}]},testimonials:{title:"Hear from our customers",content:[{name:"BBQ Chef",quote:"When I opened my physical store, I was hesitant about using Moniebook but I had to for sales. To my shock, in my first month, Moniebook showed I’d made over 2 million in total sales! I screamed with joy and thought, “Me and Moniebook? For life!” It saves me the stress of manual calculations, tracks my sales month-to-month, monitors stock, and manages all my inventory. I love that my products are right there on the terminal, so even new team members can use it easily.",image:"/moniebook/testimonial-1.png"},{name:"Farm Flavours",quote:"Moniebook has completely transformed the business. At first, I was hesitant but after using it, I discovered I made more sales in the first month! It tracks sales, monitors stock, and shows my business performance month to month, all in one place. The interface is so easy that even new team members can jump right in. Honestly, any business owner not using Moniebook is missing out! It's such a great innovation!",image:"/moniebook/testimonial-2.png"},{name:"Mama K.C Restaurants",quote:"It has improved our business significantly. After every sale, we get a clear breakdown of all transactions! The system is user-friendly, easy to learn, and very affordable. Most importantly, it has boosted my staff's efficiency and overall business productivity in a big way.",image:"/moniebook/testimonial-3.png"},{name:"Fuse Sunset Grill",quote:"It’s been great and has completely transformed how I run my business. Before, keeping track of sales, inventory, and daily transactions was stressful and time-consuming. But now, everything is organized and automated, saving me so much effort. I have no complaints at all!",image:"/moniebook/testimonial-4.png"},{name:"Light House Cakes & Pastries",quote:"Now, it’s so easy to track daily sales unlike before when we relied on pen and paper. Moniebook breaks down every transaction clearly, giving us real-time insights into our daily performance. No more guesswork or manual calculations; we can see exactly how the business is doing at a glance!",image:"/moniebook/testimonial-5.png"}]},carousel:{title:"Our range of products For every business.",desc:"Come behind the scenes with us as we breakdown everything we do to power business dreams",content:[{title:"POS Power Bank",desc:"Keep sales flowing during power outages with reliable backup power. Perfect for indoor and outdoor use, ensuring your POS devices stay powered while customers stay happy.",list:["Extended battery life.","Compatible with other POS devices.","Reliable backup power for both indoor and outdoor use."],image:"/business/moniebook-carousel-1.svg"},{title:"Moniebook Register",desc:"Moniebook Register makes checkout a breeze. Track sales, manage inventory and keep customers happy - all from one simple, easy-to-use POS software. Also available on mobile.",list:["Quick, easy checkout to serve customers faster.","Supports multiple payment options.","Works great for businesses of all sizes."],ctaText:"Get started in 2 minutes",ctaLink:o.lk,image:"/business/moniebook-carousel-2.svg"},{title:"T2s-Smart Desktop",desc:"Boost business efficiency with a dual-screen POS that speeds up transactions, reduces errors and keeps you operational anywhere. Ideal for stores, events, and pop-ups.",list:["Customers see their orders in real time as you process them.","Smooth, fast, and reliable transactions every single time.","Sell on the go with reliable powerbank backup support."],image:"/business/moniebook-carousel-3.svg"},{title:"D3 MINI-Smart Desktop",desc:"Maximize counter space and speed with a compact powerhouse - fast, reliable, and powerful. Perfect for food trucks, retail, and busy counters.",list:["Compact design that saves your valuable counter space.","Up to 4X faster speed for quick customer service.","No extra tablets or apps required."],image:"/business/moniebook-carousel-4.svg"},{title:"V3 MIX-Smart Tablet",desc:"Boost sales and satisfaction by letting customers browse and customize orders at their own pace. Perfect for modern dining, it frees staff to focus on service.",list:["Let customers browse and customize orders freely.","Get better reviews with smoother ordering process.","Free staff to focus on food and service quality."],image:"/business/moniebook-carousel-5.svg"}]},faqs:[{question:"Why use Moniebook?",answer:"Moniebook simplifies your business operations by providing a centralized platform for managing sales, inventory, payments, and customers. It helps improve efficiency, provides real-time insights, and supports data-driven decision-making to grow your business."},{question:"Who is Moniebook for?",answer:"Moniebook is designed for small, medium and large retail & hospitality businesses."},{question:"Is there a free trial?",answer:"Every registered business enjoys a 30-day free trial with complete access to all Moniebook features."},{question:"Can I use Moniebook with my existing Moniepoint terminal?",answer:"This is dependent on your type of terminal. Moniebook works only on the following devices: Moniepoint P8 terminal, Android, iOS, PC and mobile web."},{question:"What kind of businesses use Moniebook?",answer:"Moniebook was built for supermarkets, pharmacies, restaurants, boutiques, salons, etc."}],help:{title:"How can we help?",desc:"Got questions about setting up, using Moniebook, or general inquiries?\n         Reach out - we're here for you!",cta:"Contact support",link:o.ie},pricing:!0,cta:{ctaTitle:"Selling shouldn't be hard. With Moniebook, it's 10x easier!",ctaLink:o.mb,ctaText:"Start Free Trial"},script:n.v.moniebook,disabled:!a.v.showMoniebookPages},promotions:{meta:i.s.business.promotions,hero:{label:"Limited time offer",title:"Get rewarded when you use your POS",desc:"Get up to 30% back on interbank transfers and 15% back on POS payments — every week, just for transacting!",descTwo:"Valid only for POS owners, from 16 July to 16 September 2025."},heroSub:{label:"The more money you move, the more money you earn",desc:"Earn cashback on POS payments and interbank transfers — how much you get depends on your rewards tier. Transact more to reach higher tiers and earn more cashback.",descTwo:"Your tier is calculated weekly based on your total weekly transaction value. Cashback is applied instantly per transaction."},tiers:[{key:1,name:"Shooting star",stars:3,totalStars:5,weeklyRequirement:"₦0 – ₦699,999",posPayments:"No cashback",interbankTransfers:"No cashback"},{key:2,name:"Superstar",stars:4,totalStars:5,weeklyRequirement:"₦700,000 – ₦2,499,999",posPayments:"10% of transaction fee",interbankTransfers:"10% of transaction fee"},{key:3,name:"Megastar",stars:5,totalStars:5,weeklyRequirement:"₦2,500,000 and above",posPayments:"15% of transaction fee",interbankTransfers:"30% of transaction fee"}],cashbacksData:{payments:{title:"Up to 15% back for every withdrawal, purchase, or POS transfer",subtitle:"Valid only for POS owners, from 16 July to 16 September 2025.",buttonText:"See payment rewards",howItWorks:{title:"How it works",description:["Every payment costs a fee based on your transaction amount. Depending on your rewards tier, you can earn up to 15% of the fee back on each payment — the more you spend, the more you earn!","Your tier is based on your total weekly payments value. Each tier has a cashback amount that is a percentage of the payment fee. Your tier will reset weekly, and apply to the following week."]},tableSection:{subtitle:"Less than ₦3,000",title:"Rewards tiers and cashback on small payments",headers:["Rewards tier","Weekly transaction requirement","Fee charged","Cashback per payment"],rows:[{tier:{name:"Megastar",stars:5},requirement:"₦2,500,000 and above",fee:"0.5% of amount",cashback:"15% of the fee"},{tier:{name:"Superstar",stars:4},requirement:"₦700,000 – ₦2,499,999",fee:"0.5% of amount",cashback:"10% of the fee"},{tier:{name:"Shooting star",stars:3},requirement:"₦0 – ₦699,999",fee:"0.5% of amount",cashback:"No cashback"}]},largePaymentsTable:{subtitle:"More than ₦3,000",title:"Rewards tiers and cashback on large payments",headers:[{title:"Transaction amount"},{title:"Fee charged"},{title:"Shooting star",subtitle:"No cashback"},{title:"Superstar",subtitle:"10% cashback"},{title:"Megastar",subtitle:"15% cashback"}],rows:[{amount:"₦3,001 – ₦4,000",fee:"₦20.00",shooting:"₦0",superstar:"₦2.00",megastar:"₦3.00"},{amount:"₦4,001 – ₦5,000",fee:"₦25.00",shooting:"₦0",superstar:"₦2.50",megastar:"₦3.75"},{amount:"₦5,001 – ₦6,000",fee:"₦30.00",shooting:"₦0",superstar:"₦3.00",megastar:"₦4.50"},{amount:"₦6,001 – ₦7,000",fee:"₦35.00",shooting:"₦0",superstar:"₦3.50",megastar:"₦5.25"},{amount:"₦7,001 – ₦8,000",fee:"₦40.00",shooting:"₦0",superstar:"₦4.00",megastar:"₦6.00"},{amount:"₦8,001 – ₦9,000",fee:"₦45.00",shooting:"₦0",superstar:"₦4.50",megastar:"₦6.75"},{amount:"₦9,001 – ₦10,000",fee:"₦50.00",shooting:"₦0",superst